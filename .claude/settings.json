{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git reset --hard:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/canary.sh\" sessionstart-nomatcher",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/canary.sh\" sessionstart-startup",
            "timeout": 10
          }
        ],
        "matcher": "startup"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/canary.sh\" sessionstart-resume",
            "timeout": 10
          }
        ],
        "matcher": "resume"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/canary.sh\" sessionstart-pipe",
            "timeout": 10
          }
        ],
        "matcher": "startup|resume"
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"",
            "timeout": 120,
            "statusMessage": "Mounting the .aos layer"
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"",
            "timeout": 120,
            "statusMessage": "Mounting the .aos layer"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/canary.sh\" pretooluse-empty",
            "timeout": 10
          }
        ],
        "matcher": ""
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/.aos/sys/core/scripts/monitor-pre.py\" ] && python3 \"$CLAUDE_PROJECT_DIR/.aos/sys/core/scripts/monitor-pre.py\"",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/.aos/sys/core/scripts/capture-pre.py\" ] && python3 \"$CLAUDE_PROJECT_DIR/.aos/sys/core/scripts/capture-pre.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/canary.sh\" pretooluse-bash",
            "timeout": 10
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/canary.sh\" posttooluse-empty",
            "timeout": 10
          }
        ],
        "matcher": ""
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/.aos/sys/core/scripts/monitor-post.py\" ] && python3 \"$CLAUDE_PROJECT_DIR/.aos/sys/core/scripts/monitor-post.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/.aos/sys/core/scripts/check-context-threshold.py\" ] && python3 \"$CLAUDE_PROJECT_DIR/.aos/sys/core/scripts/check-context-threshold.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/canary.sh\" stop-empty",
            "timeout": 10
          }
        ],
        "matcher": ""
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/.aos/sys/core/scripts/capture-stop.py\" ] && python3 \"$CLAUDE_PROJECT_DIR/.aos/sys/core/scripts/capture-stop.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
