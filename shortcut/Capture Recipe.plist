<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Cookframe — Capture Recipe (CFV1-SL5, PDR-0003).

  THIS FILE IS THE SOURCE OF TRUTH for the product's mobile client. A hosted
  share link may mirror it; the mirror is never the authoritative copy, and if
  the two disagree this file is right.

  It carries NO credential and NO instance identifier. The two values it needs —
  the base URL of your instance and its ingest credential — are asked for at
  IMPORT time (see WFWorkflowImportQuestions at the end) and stored in your own
  copy on your own device, never here. `cookframe.example` below is a placeholder
  in a reserved domain (RFC 2606); it resolves nowhere and identifies nobody.

  The credential it asks for is the instance-scoped ingest credential. It grants
  submitting a capture to one instance and nothing else: it is not a
  model-provider credential, cannot be exchanged for one, and reaches no part of
  the library. Losing the phone costs submission to that instance.

  What it does: photograph a recipe page, POST the image to <base>/capture, and
  show what came back — the imported recipe's title, or the refusal's own
  sentence. The refusal matters most: a page holding several recipes is refused
  rather than truncated to one, and the message names how many were found and
  what they were called.
-->
<plist version="1.0">
<dict>
	<key>WFWorkflowClientVersion</key>
	<string>1200</string>
	<key>WFWorkflowMinimumClientVersion</key>
	<integer>900</integer>
	<key>WFWorkflowMinimumClientVersionString</key>
	<string>900</string>
	<key>WFWorkflowIcon</key>
	<dict>
		<key>WFWorkflowIconGlyphNumber</key>
		<integer>59769</integer>
		<key>WFWorkflowIconStartColor</key>
		<integer>4292093695</integer>
	</dict>
	<key>WFWorkflowInputContentItemClasses</key>
	<array>
		<string>WFImageContentItem</string>
	</array>
	<key>WFWorkflowTypes</key>
	<array>
		<string>ActionExtension</string>
	</array>
	<key>WFWorkflowHasShortcutInputVariables</key>
	<false/>
	<key>WFWorkflowActions</key>
	<array>
		<!-- 0. The base URL of your instance. Asked at import; nothing is baked in. -->
		<dict>
			<key>WFWorkflowActionIdentifier</key>
			<string>is.workflow.actions.gettext</string>
			<key>WFWorkflowActionParameters</key>
			<dict>
				<key>UUID</key>
				<string>3F1B0A2C-0001-4C6E-9A21-C0F3E1A40001</string>
				<key>CustomOutputName</key>
				<string>Instance</string>
				<key>WFTextActionText</key>
				<string>https://cookframe.example</string>
			</dict>
		</dict>
		<!-- 1. The instance-scoped ingest credential. Asked at import; never in this file. -->
		<dict>
			<key>WFWorkflowActionIdentifier</key>
			<string>is.workflow.actions.gettext</string>
			<key>WFWorkflowActionParameters</key>
			<dict>
				<key>UUID</key>
				<string>3F1B0A2C-0002-4C6E-9A21-C0F3E1A40002</string>
				<key>CustomOutputName</key>
				<string>Credential</string>
				<key>WFTextActionText</key>
				<string>paste-your-instance-ingest-credential-here</string>
			</dict>
		</dict>
		<!-- 2. Photograph the page. This is why the entry point exists: capture
		     starts here, without opening the application first. -->
		<dict>
			<key>WFWorkflowActionIdentifier</key>
			<string>is.workflow.actions.takephoto</string>
			<key>WFWorkflowActionParameters</key>
			<dict>
				<key>UUID</key>
				<string>3F1B0A2C-0003-4C6E-9A21-C0F3E1A40003</string>
				<key>CustomOutputName</key>
				<string>Page</string>
				<key>WFCameraCaptureShowPreview</key>
				<true/>
			</dict>
		</dict>
		<!-- 3. Submit it. One request: the image is the body, the credential is a
		     bearer token, and the media type is stated rather than guessed. -->
		<dict>
			<key>WFWorkflowActionIdentifier</key>
			<string>is.workflow.actions.downloadurl</string>
			<key>WFWorkflowActionParameters</key>
			<dict>
				<key>UUID</key>
				<string>3F1B0A2C-0004-4C6E-9A21-C0F3E1A40004</string>
				<key>CustomOutputName</key>
				<string>Reply</string>
				<key>WFHTTPMethod</key>
				<string>POST</string>
				<key>WFHTTPBodyType</key>
				<string>File</string>
				<key>WFRequestVariable</key>
				<dict>
					<key>Value</key>
					<dict>
						<key>Type</key>
						<string>ActionOutput</string>
						<key>OutputName</key>
						<string>Page</string>
						<key>OutputUUID</key>
						<string>3F1B0A2C-0003-4C6E-9A21-C0F3E1A40003</string>
					</dict>
					<key>WFSerializationType</key>
					<string>WFTextTokenAttachment</string>
				</dict>
				<key>WFURL</key>
				<dict>
					<key>Value</key>
					<dict>
						<key>string</key>
						<string>￼/capture</string>
						<key>attachmentsByRange</key>
						<dict>
							<key>{0, 1}</key>
							<dict>
								<key>Type</key>
								<string>ActionOutput</string>
								<key>OutputName</key>
								<string>Instance</string>
								<key>OutputUUID</key>
								<string>3F1B0A2C-0001-4C6E-9A21-C0F3E1A40001</string>
							</dict>
						</dict>
					</dict>
					<key>WFSerializationType</key>
					<string>WFTextTokenString</string>
				</dict>
				<key>WFHTTPHeaders</key>
				<dict>
					<key>Value</key>
					<dict>
						<key>WFDictionaryFieldValueItems</key>
						<array>
							<dict>
								<key>WFItemType</key>
								<integer>0</integer>
								<key>WFKey</key>
								<dict>
									<key>Value</key>
									<dict>
										<key>string</key>
										<string>Authorization</string>
									</dict>
									<key>WFSerializationType</key>
									<string>WFTextTokenString</string>
								</dict>
								<key>WFValue</key>
								<dict>
									<key>Value</key>
									<dict>
										<key>string</key>
										<string>Bearer ￼</string>
										<key>attachmentsByRange</key>
										<dict>
											<key>{7, 1}</key>
											<dict>
												<key>Type</key>
												<string>ActionOutput</string>
												<key>OutputName</key>
												<string>Credential</string>
												<key>OutputUUID</key>
												<string>3F1B0A2C-0002-4C6E-9A21-C0F3E1A40002</string>
											</dict>
										</dict>
									</dict>
									<key>WFSerializationType</key>
									<string>WFTextTokenString</string>
								</dict>
							</dict>
							<dict>
								<key>WFItemType</key>
								<integer>0</integer>
								<key>WFKey</key>
								<dict>
									<key>Value</key>
									<dict>
										<key>string</key>
										<string>Content-Type</string>
									</dict>
									<key>WFSerializationType</key>
									<string>WFTextTokenString</string>
								</dict>
								<key>WFValue</key>
								<dict>
									<key>Value</key>
									<dict>
										<key>string</key>
										<string>image/jpeg</string>
									</dict>
									<key>WFSerializationType</key>
									<string>WFTextTokenString</string>
								</dict>
							</dict>
						</array>
					</dict>
					<key>WFSerializationType</key>
					<string>WFDictionaryFieldValue</string>
				</dict>
			</dict>
		</dict>
		<!-- 4. The refusal's own sentence, if there is one. `message` is present on
		     a refusal and absent on a success, so it is the discriminator. -->
		<dict>
			<key>WFWorkflowActionIdentifier</key>
			<string>is.workflow.actions.getvalueforkey</string>
			<key>WFWorkflowActionParameters</key>
			<dict>
				<key>UUID</key>
				<string>3F1B0A2C-0005-4C6E-9A21-C0F3E1A40005</string>
				<key>CustomOutputName</key>
				<string>Refusal</string>
				<key>WFDictionaryKey</key>
				<string>message</string>
				<key>WFInput</key>
				<dict>
					<key>Value</key>
					<dict>
						<key>Type</key>
						<string>ActionOutput</string>
						<key>OutputName</key>
						<string>Reply</string>
						<key>OutputUUID</key>
						<string>3F1B0A2C-0004-4C6E-9A21-C0F3E1A40004</string>
					</dict>
					<key>WFSerializationType</key>
					<string>WFTextTokenAttachment</string>
				</dict>
			</dict>
		</dict>
		<!-- 5. If the reply carried a refusal, SHOW IT. This branch is the whole
		     point of `slice5/multi-recipe-refusal-reaches-the-person`: the count
		     and the titles are in that sentence, and a person reads them. -->
		<dict>
			<key>WFWorkflowActionIdentifier</key>
			<string>is.workflow.actions.conditional</string>
			<key>WFWorkflowActionParameters</key>
			<dict>
				<key>GroupingIdentifier</key>
				<string>3F1B0A2C-0006-4C6E-9A21-C0F3E1A40006</string>
				<key>WFControlFlowMode</key>
				<integer>0</integer>
				<key>WFCondition</key>
				<integer>100</integer>
				<key>WFInput</key>
				<dict>
					<key>Value</key>
					<dict>
						<key>Type</key>
						<string>ActionOutput</string>
						<key>OutputName</key>
						<string>Refusal</string>
						<key>OutputUUID</key>
						<string>3F1B0A2C-0005-4C6E-9A21-C0F3E1A40005</string>
					</dict>
					<key>WFSerializationType</key>
					<string>WFTextTokenAttachment</string>
				</dict>
			</dict>
		</dict>
		<dict>
			<key>WFWorkflowActionIdentifier</key>
			<string>is.workflow.actions.alert</string>
			<key>WFWorkflowActionParameters</key>
			<dict>
				<key>WFAlertActionCancelButtonShown</key>
				<false/>
				<key>WFAlertActionTitle</key>
				<string>Not imported</string>
				<key>WFAlertActionMessage</key>
				<dict>
					<key>Value</key>
					<dict>
						<key>string</key>
						<string>￼</string>
						<key>attachmentsByRange</key>
						<dict>
							<key>{0, 1}</key>
							<dict>
								<key>Type</key>
								<string>ActionOutput</string>
								<key>OutputName</key>
								<string>Refusal</string>
								<key>OutputUUID</key>
								<string>3F1B0A2C-0005-4C6E-9A21-C0F3E1A40005</string>
							</dict>
						</dict>
					</dict>
					<key>WFSerializationType</key>
					<string>WFTextTokenString</string>
				</dict>
			</dict>
		</dict>
		<!-- 6. Otherwise: it was imported, and the title says which recipe. -->
		<dict>
			<key>WFWorkflowActionIdentifier</key>
			<string>is.workflow.actions.conditional</string>
			<key>WFWorkflowActionParameters</key>
			<dict>
				<key>GroupingIdentifier</key>
				<string>3F1B0A2C-0006-4C6E-9A21-C0F3E1A40006</string>
				<key>WFControlFlowMode</key>
				<integer>1</integer>
			</dict>
		</dict>
		<dict>
			<key>WFWorkflowActionIdentifier</key>
			<string>is.workflow.actions.getvalueforkey</string>
			<key>WFWorkflowActionParameters</key>
			<dict>
				<key>UUID</key>
				<string>3F1B0A2C-0007-4C6E-9A21-C0F3E1A40007</string>
				<key>CustomOutputName</key>
				<string>Title</string>
				<key>WFDictionaryKey</key>
				<string>title</string>
				<key>WFInput</key>
				<dict>
					<key>Value</key>
					<dict>
						<key>Type</key>
						<string>ActionOutput</string>
						<key>OutputName</key>
						<string>Reply</string>
						<key>OutputUUID</key>
						<string>3F1B0A2C-0004-4C6E-9A21-C0F3E1A40004</string>
					</dict>
					<key>WFSerializationType</key>
					<string>WFTextTokenAttachment</string>
				</dict>
			</dict>
		</dict>
		<dict>
			<key>WFWorkflowActionIdentifier</key>
			<string>is.workflow.actions.alert</string>
			<key>WFWorkflowActionParameters</key>
			<dict>
				<key>WFAlertActionCancelButtonShown</key>
				<false/>
				<key>WFAlertActionTitle</key>
				<string>Imported</string>
				<key>WFAlertActionMessage</key>
				<dict>
					<key>Value</key>
					<dict>
						<key>string</key>
						<string>￼</string>
						<key>attachmentsByRange</key>
						<dict>
							<key>{0, 1}</key>
							<dict>
								<key>Type</key>
								<string>ActionOutput</string>
								<key>OutputName</key>
								<string>Title</string>
								<key>OutputUUID</key>
								<string>3F1B0A2C-0007-4C6E-9A21-C0F3E1A40007</string>
							</dict>
						</dict>
					</dict>
					<key>WFSerializationType</key>
					<string>WFTextTokenString</string>
				</dict>
			</dict>
		</dict>
		<dict>
			<key>WFWorkflowActionIdentifier</key>
			<string>is.workflow.actions.conditional</string>
			<key>WFWorkflowActionParameters</key>
			<dict>
				<key>GroupingIdentifier</key>
				<string>3F1B0A2C-0006-4C6E-9A21-C0F3E1A40006</string>
				<key>WFControlFlowMode</key>
				<integer>2</integer>
			</dict>
		</dict>
	</array>
	<!--
	  Asked once, at import, and stored only in the importer's own copy. This is
	  the mechanism that lets the committed definition stay free of both the
	  instance identifier and the credential.
	-->
	<key>WFWorkflowImportQuestions</key>
	<array>
		<dict>
			<key>ActionIndex</key>
			<integer>0</integer>
			<key>Category</key>
			<string>Parameter</string>
			<key>ParameterKey</key>
			<string>WFTextActionText</string>
			<key>Text</key>
			<string>What is your Cookframe instance's base URL? (for example https://cookframe.example)</string>
			<key>DefaultValue</key>
			<string>https://cookframe.example</string>
		</dict>
		<dict>
			<key>ActionIndex</key>
			<integer>1</integer>
			<key>Category</key>
			<string>Parameter</string>
			<key>ParameterKey</key>
			<string>WFTextActionText</string>
			<key>Text</key>
			<string>Paste your instance's ingest credential. It submits captures to that one instance and nothing else.</string>
			<key>DefaultValue</key>
			<string>paste-your-instance-ingest-credential-here</string>
		</dict>
	</array>
</dict>
</plist>
