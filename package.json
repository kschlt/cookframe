{
  "name": "cookframe",
  "version": "0.0.0",
  "private": true,
  "description": "Convert heterogeneous recipe sources into a durable, provider-independent Canonical Recipe.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:schema-contract": "vitest run tests/schema",
    "test:normalization-invariant": "vitest run tests/normalization",
    "test:url-fetch-security": "vitest run tests/url-fetch",
    "test:model-egress": "vitest run tests/security",
    "test:dbq": "vitest run tests/dbq",
    "test:persistence": "vitest run tests/persistence",
    "test:protections": "vitest run tests/protections",
    "test:slice1": "vitest run tests/slice1",
    "test:slice3": "vitest run tests/slice3",
    "test:slice4": "vitest run tests/slice4",
    "test:slice5": "vitest run tests/slice5",
    "test:slice6": "vitest run tests/slice6",
    "test:records": "vitest run tests/records",
    "test:cooking-ux": "vitest run tests/cooking-ux",
    "test:run": "vitest run tests/run",
    "test:watch": "vitest",
    "start": "node --import tsx src/server/main.ts",
    "eval": "tsx evals/harness.ts",
    "quality": "npm run typecheck && biome ci . && vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.8",
    "ipaddr.js": "^2.5.0",
    "pg": "^8.23.0",
    "undici": "^7.29.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0",
    "yaml": "^2.7.0"
  }
}
